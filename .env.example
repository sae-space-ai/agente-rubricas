# Variables de entorno para desarrollo local
# Copia este archivo a .env y completa los valores

# Nebius Token Factory API Key
# Obtén tu API key en: https://nebius.com/services/token-factory
NEBIUS_API_KEY=tu_api_key_aqui

# URL de la API (opcional, solo para desarrollo local)
# En producción (Vercel), deja esto vacío
VITE_API_URL=
